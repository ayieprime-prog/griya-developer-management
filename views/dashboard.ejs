<%- include('partials/header', { title: 'Dashboard' }) %>

<div class="row mb-4">
  <div class="col-md-12">
    <h1 class="mb-3">Dashboard</h1>
    <p class="text-muted">Selamat datang, <strong><%= user.nama_lengkap %></strong> (<%= ROLE_LABELS[user.role] %>)</p>
  </div>
</div>

<% if (typeof stats !== 'undefined') { %>
  <div class="row mb-4">
    <div class="col-md-3 mb-3">
      <div class="card border-left-primary h-100 py-2">
        <div class="card-body">
          <div class="text-primary text-uppercase mb-1">
            <small class="font-weight-bold">Total Kerjasama</small>
          </div>
          <div class="h3 mb-0"><%= stats.totalKerjasama || 0 %></div>
        </div>
      </div>
    </div>

    <div class="col-md-3 mb-3">
      <div class="card border-left-success h-100 py-2">
        <div class="card-body">
          <div class="text-success text-uppercase mb-1">
            <small class="font-weight-bold">Disetujui</small>
          </div>
          <div class="h3 mb-0"><%= stats.disetujui || 0 %></div>
        </div>
      </div>
    </div>

    <div class="col-md-3 mb-3">
      <div class="card border-left-warning h-100 py-2">
        <div class="card-body">
          <div class="text-warning text-uppercase mb-1">
            <small class="font-weight-bold">Menunggu Verifikasi</small>
          </div>
          <div class="h3 mb-0"><%= stats.menungguVerifikasi || 0 %></div>
        </div>
      </div>
    </div>

    <div class="col-md-3 mb-3">
      <div class="card border-left-danger h-100 py-2">
        <div class="card-body">
          <div class="text-danger text-uppercase mb-1">
            <small class="font-weight-bold">Ditolak</small>
          </div>
          <div class="h3 mb-0"><%= stats.ditolak || 0 %></div>
        </div>
      </div>
    </div>
  </div>
<% } %>

<div class="row">
  <div class="col-md-12">
    <div class="card">
      <div class="card-header">
        <h5 class="mb-0">Menu Utama</h5>
      </div>
      <div class="card-body">
        <div class="row">
          <% if (['admin', 'account_officer', 'supervisor', 'pemimpin_cabang'].includes(user.role)) { %>
            <div class="col-md-4 mb-3">
              <a href="/kerjasama-developer" class="btn btn-outline-primary w-100 h-100 py-3" style="text-align: left;">
                <div>
                  <i class="fas fa-list fa-2x text-primary"></i>
                  <div class="mt-2">
                    <strong>Daftar Kerjasama</strong>
                    <p class="small text-muted mb-0">Lihat semua perjanjian kerjasama</p>
                  </div>
                </div>
              </a>
            </div>

            <div class="col-md-4 mb-3">
              <a href="/kerjasama-developer/new" class="btn btn-outline-success w-100 h-100 py-3" style="text-align: left;">
                <div>
                  <i class="fas fa-plus fa-2x text-success"></i>
                  <div class="mt-2">
                    <strong>Pengajuan Baru</strong>
                    <p class="small text-muted mb-0">Buat kerjasama baru dengan developer</p>
                  </div>
                </div>
              </a>
            </div>

            <div class="col-md-4 mb-3">
              <a href="/developer" class="btn btn-outline-info w-100 h-100 py-3" style="text-align: left;">
                <div>
                  <i class="fas fa-database fa-2x text-info"></i>
                  <div class="mt-2">
                    <strong>Database Developer</strong>
                    <p class="small text-muted mb-0">Kelola data developer PKS</p>
                  </div>
                </div>
              </a>
            </div>
          <% } %>

          <% if (['admin', 'supervisor', 'pemimpin_cabang'].includes(user.role)) { %>
            <div class="col-md-4 mb-3">
              <a href="/monitoring" class="btn btn-outline-warning w-100 h-100 py-3" style="text-align: left;">
                <div>
                  <i class="fas fa-chart-bar fa-2x text-warning"></i>
                  <div class="mt-2">
                    <strong>Monitoring Kerjasama</strong>
                    <p class="small text-muted mb-0">Laporan dan analisis kerjasama</p>
                  </div>
                </div>
              </a>
            </div>
          <% } %>

          <% if (user.role === 'admin') { %>
            <div class="col-md-4 mb-3">
              <a href="/users" class="btn btn-outline-secondary w-100 h-100 py-3" style="text-align: left;">
                <div>
                  <i class="fas fa-users fa-2x text-secondary"></i>
                  <div class="mt-2">
                    <strong>Kelola Pengguna</strong>
                    <p class="small text-muted mb-0">User management dan akses</p>
                  </div>
                </div>
              </a>
            </div>

            <div class="col-md-4 mb-3">
              <a href="/audit" class="btn btn-outline-danger w-100 h-100 py-3" style="text-align: left;">
                <div>
                  <i class="fas fa-history fa-2x text-danger"></i>
                  <div class="mt-2">
                    <strong>Audit Trail</strong>
                    <p class="small text-muted mb-0">Log aktivitas sistem</p>
                  </div>
                </div>
              </a>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
