<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' - Griya Developer Management' : 'Griya Developer Management' %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">
        <i class="fas fa-building"></i> Griya Developer Management
      </a>

      <% if (typeof user !== 'undefined' && user) { %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item">
              <a class="nav-link" href="/dashboard">
                <i class="fas fa-chart-line"></i> Dashboard
              </a>
            </li>

            <% if (['admin', 'account_officer', 'supervisor', 'pemimpin_cabang'].includes(user.role)) { %>
              <!-- Dropdown for Kerjasama Developer -->
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                  <i class="fas fa-handshake"></i> Kerjasama Developer
                </a>
                <ul class="dropdown-menu">
                  <li><a class="dropdown-item" href="/kerjasama-developer">
                    <i class="fas fa-list"></i> Daftar Kerjasama
                  </a></li>
                  <li><a class="dropdown-item" href="/kerjasama-developer/new">
                    <i class="fas fa-plus"></i> Pengajuan Kerjasama
                  </a></li>
                  <li><hr class="dropdown-divider"></li>
                  <li><a class="dropdown-item" href="/developer">
                    <i class="fas fa-database"></i> Pendaftaran Developer PKS
                  </a></li>
                  <li><a class="dropdown-item" href="/monitoring">
                    <i class="fas fa-chart-bar"></i> Monitoring Kerjasama
                  </a></li>
                </ul>
              </li>
            <% } %>

            <% if (user.role === 'admin') { %>
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                  <i class="fas fa-cogs"></i> Admin
                </a>
                <ul class="dropdown-menu">
                  <li><a class="dropdown-item" href="/users">
                    <i class="fas fa-users"></i> Kelola Pengguna
                  </a></li>
                  <li><a class="dropdown-item" href="/audit">
                    <i class="fas fa-history"></i> Audit Trail
                  </a></li>
                </ul>
              </li>
            <% } %>

            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                <i class="fas fa-user-circle"></i> <%= user.nama_lengkap %>
              </a>
              <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" href="/profil">
                  <i class="fas fa-user"></i> Profil
                </a></li>
                <li><a class="dropdown-item" href="/profil/password">
                  <i class="fas fa-key"></i> Ubah Password
                </a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" href="/logout">
                  <i class="fas fa-sign-out-alt"></i> Logout
                </a></li>
              </ul>
            </li>
          </ul>
        </div>
      <% } %>
    </div>
  </nav>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="container-fluid mt-3">
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> <%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    </div>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="container-fluid mt-3">
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle"></i> <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    </div>
  <% } %>

  <div class="container-fluid pt-4">
